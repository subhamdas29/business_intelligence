# ==========================================
# AI BI Platform - Environment Configuration
# ==========================================

# Environment Mode: development | staging | production
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_key_in_production_32_bytes_min
API_V1_STR=/api/v1
PROJECT_NAME="AI Business Intelligence Platform"

# Authentication & JWT
JWT_SECRET_KEY=super_secret_jwt_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Configuration (App & Analytics)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aibi_platform

# Read-only Database User (for safe LLM SQL Query Execution)
POSTGRES_READONLY_USER=aibi_readonly
POSTGRES_READONLY_PASSWORD=readonly_secure_pass

# Redis Configuration (Celery & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Storage Provider Configuration: local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage/uploads

# AWS / S3 Configuration (Used if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=aibi-platform-datasets

# LLM Provider Configuration: openai | anthropic | gemini | local
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o
LLM_API_KEY=your_openai_api_key_here

# Embedding Configuration
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Vector Database (pgvector via PostgreSQL)
VECTOR_DB_COLLECTION=document_embeddings

# Rate Limiting & File Upload Limits
MAX_UPLOAD_SIZE_MB=100
ALLOWED_FILE_EXTENSIONS=.csv,.xlsx,.xls
